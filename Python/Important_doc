#1 remove the broken one
rm -rf venv

#2 recreate it cleanly with the same Python version as your kernel (3.14)
python3.14 -m venv venv

#3 activate it
source venv/bin/activate

#4 confirm you're in it
which python   # should show .../Python/venv/bin/python

#5 install numpy inside it
pip install numpy

# Check if the venv actually exists properly
ls venv/bin
# note If activate isn't listed there, the venv is broken/incomplete. so run step1 to step 5
